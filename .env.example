# Copy this file to .env and fill in your own values. Never commit .env itself.

# Required by SEC EDGAR: a descriptive User-Agent with a real contact email.
# No registration needed -- SEC just wants a way to reach you if a script misbehaves.
SEC_USER_AGENT="Your Name your.email@example.com"

# Free tier, no credit card: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-2.5-flash"

# Local fallback -- install from https://ollama.com, then `ollama pull llama3.1`
OLLAMA_BASE_URL="http://localhost:11434"
OLLAMA_MODEL="llama3.1"

# Local paths (defaults are usually fine)
RAW_DATA_DIR="data/raw"
PROCESSED_DATA_DIR="data/processed"

# Leave as-is for SQLite, or point at the docker-compose Postgres service instead:
# DATABASE_URL="postgresql://postgres:postgres@localhost:5432/financial_rag"
DATABASE_URL="sqlite:///data/processed/financial_rag.db"
